{
  "providers": {
    "openrouter": {
      "apiKey": "${OPENROUTER_API_KEY}"
    },
    "ollama": {
      "apiKey": "ollama"
    }
  },
  "agents": {
    "defaults": {
      "model": "deepseek/deepseek-v4-pro",
      "provider": "openrouter",
      "maxTokens": 4096,
      "contextWindowTokens": 65536,
      "temperature": 0.1,
      "maxToolIterations": 10,
      "workspace": "~/.nanobot/workspace",
      "timezone": "${NANOBOT_TIMEZONE}",
      "providerRetryMode": "standard",
      "dream": {
        "intervalH": 4,
        "maxBatchSize": 20,
        "maxIterations": 10,
        "modelOverride": null
      }
    }
  },
  "channels": {
    "sendProgress": false,
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [
        "${TELEGRAM_USER_ID}"
      ],
      "streaming": true,
      "streamEditInterval": 0.6,
      "groupPolicy": "mention",
      "connectionPoolSize": 32
    }
  },
  "tools": {
    "web": {
      "enable": true
    },
    "exec": {
      "enable": false
    },
    "mcpServers": {
      "google-calendar": {
        "command": "node",
        "args": [
          "${ADHD_REPO_ROOT}/mcp/google-calendar/build/index.js"
        ],
        "enabledTools": [
          "list-events",
          "get-freebusy"
        ],
        "env": {
          "GOOGLE_OAUTH_CREDENTIALS": "${GOOGLE_OAUTH_CREDENTIALS}",
          "GOOGLE_CALENDAR_MCP_TOKEN_PATH": "${GOOGLE_CALENDAR_MCP_TOKEN_PATH}"
        }
      }
    }
  }
}
