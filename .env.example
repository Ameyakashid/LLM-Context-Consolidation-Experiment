# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required: Telegram bot token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Required: Your Telegram numeric user ID (from @userinfobot on Telegram)
TELEGRAM_USER_ID=123456789

# Optional: IANA timezone for scheduling and timestamps (default: America/New_York)
NANOBOT_TIMEZONE=America/New_York

# Optional: Enable auto-voice for scheduled check-ins and buffer alerts (true/false)
VOICE_AUTO_ENABLED=false

# Optional: Enable Disco Elysium personality voice (placeholder for task 11)
VOICE_DISCO_ENABLED=false

# Optional: Override data directory for task/buffer/memory/schedule stores
ADHD_DATA_DIR=data

# Optional: Override path to cognitive states config
ADHD_STATES_PATH=workspace/states.yaml

# Optional: Dashboard API configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8085
DASHBOARD_DATA_DIR=data
DASHBOARD_STATIC_DIR=dashboard
DASHBOARD_REFRESH_INTERVAL=30000

# Optional: Google Calendar MCP feature flag. When false, setup_workspace.py
# skips the npm build and the gateway does not spawn the MCP server.
GOOGLE_CALENDAR_ENABLED=false

# Optional: Absolute path to OAuth client secrets JSON downloaded from the
# Google Cloud Console (Desktop client). Leave blank until you have run the
# one-time OAuth flow; see mcp/google-calendar/docs/ for details.
GOOGLE_OAUTH_CREDENTIALS=

# Optional: Where refresh tokens are persisted. Default is
# ~/.nanobot/data/google-calendar/tokens.json (diverges from upstream's
# ~/.config/google-calendar-mcp/tokens.json to co-locate with ADHD data).
GOOGLE_CALENDAR_MCP_TOKEN_PATH=

# Optional: Absolute path to this repo. Defaults to the repo root that
# setup_workspace.py was invoked from. Override only if deploying the
# resolved config on a host where the repo lives at a different path.
ADHD_REPO_ROOT=
