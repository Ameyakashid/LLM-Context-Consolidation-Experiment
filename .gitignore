# Environment and secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# nanobot runtime lives in ~/.nanobot/ outside the repo; nothing to
# ignore here. (gitignore does not expand ~, so any pattern would be a
# no-op anyway.)

# Runtime logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Agent framework (not part of the app)
Antigravity-Agent-guided/
_build/
templates/
!workspace/templates/
rules/
run-task.sh
.claude/

# Cloned reference repos (contain their own .git dirs)
references/

# User data (generated at runtime)
workspace/memory/
workspace/data/
/data/
*.jsonl
state.json

# Vendored Google Calendar MCP — build artefacts + real OAuth secrets
mcp/google-calendar/node_modules/
mcp/google-calendar/build/
gcp-oauth.keys.json
gcp-oauth.keys.*.json
!gcp-oauth.keys.example.json

# Cabinet frontend: renderer .js/.css/html are tracked; runtime-written
# feeds + wallpaper manifest/images are not. .gitkeep keeps the dirs.
cabinet/feeds/*.md
cabinet/feeds/*.json
cabinet/wallpapers/manifest.json
cabinet/wallpapers/*.png
cabinet/wallpapers/*.jpg
cabinet/wallpapers/*.jpeg
!cabinet/feeds/.gitkeep
!cabinet/wallpapers/.gitkeep

# Vendored tasklib — pip install artefacts + live Taskwarrior data
vendor/tasklib/*.egg-info/
vendor/tasklib/build/
workspace/data/taskwarrior/

# Vendored syncall — stray pip install artefacts + live sync state
vendor/syncall/*.egg-info/
vendor/syncall/build/
vendor/syncall/dist/
workspace/data/syncall_cache/
workspace/data/syncall_daemon.log
# Home-scoped OAuth token cache syncall hardcodes at Path.home(); if a
# stray copy lands under the repo root it must not be committed.
.gcal_credentials.pickle

# OS
.DS_Store
Thumbs.db
